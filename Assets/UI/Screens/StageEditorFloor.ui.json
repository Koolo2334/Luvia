      {
        "kind": "Button",
        "name": "Down",
        "style": "EdButton",
        "size": [28, 22],
        "sizeRule": "fixed",
        "offset": [262, 0],
        "children": [
          {
            "kind": "Text",
            "name": "DownLabel",
            "style": "EdLabel",
            "text": "v"
          }
        ]
      },
      {
        "kind": "Button",
        "name": "Delete",
        "style": "EdButton",
        "size": [28, 22],
        "sizeRule": "fixed",
        "offset": [294, 0],
        "children": [
          {
            "kind": "Text",
            "name": "DeleteLabel",
            "style": "EdLabel",
            "text": "X"
          }
        ]
